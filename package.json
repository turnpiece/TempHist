{
  "name": "temphist",
  "version": "1.2.28",
  "description": "Daily temperature history chart. Shows the temperature on the same day each year over the past 50 years for the current location.",
  "main": "src/main.ts",
  "scripts": {
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:watch": "vitest --watch",
    "start": "node server.js",
    "start:local": "node server-local.js",
    "dev": "vite",
    "build": "node scripts/check-locations-snapshot.mjs && npx tsc && npx vite build",
    "type-check": "npx tsc --noEmit",
    "preview": "vite preview",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "version:show": "echo $npm_package_version",
    "check:locations": "node scripts/check-locations-snapshot.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/turnpiece/TempHist.git"
  },
  "keywords": [],
  "author": "Paul Jenkins",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/turnpiece/TempHist/issues"
  },
  "homepage": "https://github.com/turnpiece/TempHist#readme",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "firebase": "^12.19.0",
    "http-proxy-middleware": "^4.2.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.1",
    "@vitest/ui": "^5.0.1",
    "axios": "^1.20.0",
    "clean-css-cli": "^5.6.3",
    "jsdom": "^30.1.1",
    "png-to-ico": "^3.0.2",
    "sass": "^1.105.1",
    "sharp": "^0.35.5",
    "terser": "^5.49.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.1"
  }
}
